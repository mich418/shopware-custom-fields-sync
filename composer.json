{
  "name": "mich418/shopware-custom-fields-sync",
  "description": "A Shopware bundle for seamless creation, updating, and removal of custom fields.",
  "type": "symfony-bundle",
  "license": "MIT",
  "require": {
    "php": "^8.1",
    "shopware/core": "^6.6",
    "symfony/framework-bundle": "^6.4 || ^7.0",
    "symfony/dependency-injection": "^6.4 || ^7.0",
    "symfony/http-kernel": "^6.4 || ^7.0",
    "symfony/config": "^6.4 || ^7.0",
    "symfony/yaml": "^6.4 || ^7.0"
  },
  "autoload": {
    "psr-4": {
      "Mich418\\ShopwareCustomFieldsSync\\": "src/"
    }
  },
  "extra": {
    "symfony": {
      "allow-contrib": true
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^10"
  },
  "config": {
    "allow-plugins": {
      "symfony/runtime": true
    }
  }
}
